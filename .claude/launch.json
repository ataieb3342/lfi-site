{
	"version": "0.0.1",
	"configurations": [
		{
			"name": "site",
			"runtimeExecutable": "npm",
			"runtimeArgs": [
				"run",
				"dev"
			],
			"port": 5173
		},
		{
			"name": "demo",
			"runtimeExecutable": "sh",
			"runtimeArgs": [
				"-c",
				"MODE_DEMO=1 DATABASE_PATH=data/demo/site.db npm run dev -- --port ${PORT:-5174} --strictPort"
			],
			"port": 5174,
			"autoPort": true
		}
	]
}
