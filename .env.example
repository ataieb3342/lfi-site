# Copiez ce fichier en .env et complétez-le AVANT la mise en production.

# Clé secrète du serveur : signature des défis anti-spam, pseudonymisation des
# adresses IP, chiffrement des secrets de double authentification.
# Générez-la avec :  openssl rand -base64 48
# Si vous la changez, toutes les sessions et toutes les 2FA sont invalidées.
SECRET_KEY=

# Adresse publique du site, protocole compris. Indispensable derrière un
# reverse proxy : sans elle, la protection CSRF de SvelteKit rejette les envois.
ORIGIN=https://exemple.fr

# Nom de domaine et adresse pour Let's Encrypt (utilisés par Caddy).
SITE_DOMAIN=exemple.fr
ADMIN_EMAIL=contact@exemple.fr

# Emplacement des données. Sauvegardez tout le dossier data/.
DATABASE_PATH=data/site.db
UPLOADS_PATH=data/uploads

# Adresse IP réelle transmise par le reverse proxy.
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1

PORT=3000
NODE_ENV=production

# Taille maximale des envois (adapter-node limite à 512 Ko par défaut,
# ce qui bloquerait les images de 5 Mo).
BODY_SIZE_LIMIT=6M

# ------------------------------------------------------------ démonstration
# MODE_DEMO=1 remplit une base vide de contenus fictifs, crée un compte de test
# et affiche ses identifiants sur la page de connexion. Réservé au site de
# démonstration (voir DEMO.md). NE JAMAIS l'activer sur le vrai site.
# MODE_DEMO=1
# DEMO_MOT_DE_PASSE=demonstration-2026
