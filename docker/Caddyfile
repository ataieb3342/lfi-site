{
	email {$ADMIN_EMAIL}
	# Caddy obtient et renouvelle le certificat HTTPS automatiquement.
}

# Le site ne se sert qu'à une seule adresse : « www » y renvoie, pour que le
# lien partagé avec un « www » devant fonctionne au lieu d'afficher une erreur
# de certificat. Sans ce bloc, Caddy ne connaît pas ce nom et ne demande pas
# de certificat pour lui.
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# Le nom et la version du serveur ne sont pas annoncés : inutile de
	# renseigner un attaquant sur ce qui tourne en face.
	header -Server

	# Les fichiers compilés portent un nom unique par version : on peut les
	# mettre en cache très longtemps.
	@statiques path /_app/immutable/*
	header @statiques Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy site:3000 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output file /data/acces.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}
